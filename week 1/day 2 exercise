# --- Exercise 2: Tuple (Immutability) ---
print("\n--- Exercise 2: Tuples ---")
my_tuple = (1, 2, 3)
print(f"Original tuple: {my_tuple}")
# Note: You cannot do my_tuple.append(4). Tuples are fixed in memory once created.
# To "add" to it, we create a new tuple by joining two:
my_tuple = my_tuple + (4, 5)
print(f"New tuple (created by concatenation): {my_tuple}")


# --- Exercise 3: List Manipulation ---
print("\n--- Exercise 3: List Manipulation ---")
basket = ["Banana", "Apples", "Oranges", "Blueberries"]
basket.remove("Banana")
basket.remove("Blueberries")
basket.append("Kiwi")
basket.insert(0, "Apples")
apple_count = basket.count("Apples")
print(f"Apples appear {apple_count} times.")
basket.clear()
print(f"Final state of basket: {basket}")


# --- Exercise 4: Floats ---
print("\n--- Exercise 4: Floats ---")
# Generating 1.5, 2, 2.5... 5 without hard-coding
floats_list = []
val = 1.5
while val <= 5:
    # If the number is a whole number (like 2.0), convert to int (2) for the display
    floats_list.append(int(val) if val % 1 == 0 else val)
    val += 0.5
print(f"Generated sequence: {floats_list}")


