# --- Exercise 8: Pizza Toppings ---
print("\n--- Exercise 8: Pizza Toppings ---")
pizza_toppings = []
base_price = 10
topping_price = 2.50

while True:
    topping = input("Enter a pizza topping (or type 'quit' to finish): ").lower()
    if topping == 'quit':
        break
    pizza_toppings.append(topping)
    print(f"Adding {topping} to your pizza.")

total_pizza_cost = base_price + (len(pizza_toppings) * topping_price)
print(f"Your pizza has: {', '.join(pizza_toppings)}")
print(f"Total cost: ${total_pizza_cost:.2f}")


# --- Exercise 9: Cinemax Tickets & Bonus ---
print("\n--- Exercise 9: Cinemax Tickets ---")
total_ticket_cost = 0
family_ages = input("Enter the ages of everyone in the family (separated by spaces): ").split()

for age_str in family_ages:
    age = int(age_str)
    if age < 3:
        continue # Free
    elif 3 <= age <= 12:
        total_ticket_cost += 10
    else:
        total_ticket_cost += 15
print(f"Total ticket cost for the family: ${total_ticket_cost}")

# Bonus: Restricted Movie
print("\n--- Bonus: Restricted Movie (Ages 16-21) ---")
teen_names = ["Alice", "Bob", "Charlie", "Diana"]
allowed_to_watch = []

for teen in teen_names:
    age = int(input(f"How old is {teen}? "))
    if 16 <= age <= 21:
