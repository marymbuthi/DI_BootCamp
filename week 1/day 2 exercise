import random

# --- Exercise 1: Favorite Numbers (Sets) ---
print("--- Exercise 1: Favorite Numbers ---")
my_fav_numbers = {7, 1, 2, 4}
my_fav_numbers.add(10)
my_fav_numbers.add(9)
my_fav_numbers.remove(2)  # Removing the last one added

