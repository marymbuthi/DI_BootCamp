# --- Exercise 4: Random ---
def compare_random(user_num):
    random_num = random.randint(1, 100)
    if user_num == random_num:
        print("Success! The numbers match.")
    else:
        print(f"Fail! Your number: {user_num}, Random number: {random_num}")

compare_random(50)


