# --- Challenge 1: Multiples of a Number ---
print("--- Challenge 1: Multiples Generator ---")
try:
    base_num = int(input("Enter the base number: "))
    list_length = int(input("Enter the desired list length: "))

    multiples_list = []

    # range(1, length + 1) ensures we get exactly the 'length' amount of multiples
    for i in range(1, list_length + 1):
        multiples_list.append(base_num * i)

    print(f"Generated Multiples: {multiples_list}")

except ValueError:
    print("Error: Please enter valid integers for the number and length.")


print("\n" + "-"*30 + "\n")


# --- Challenge 2: Remove Consecutive Duplicate Letters ---
print("--- Challenge 2: Consecutive Duplicate Remover ---")
user_word = input("Enter a word (e.g., 'ppoeemm'): ")

clean_word = ""

# Loop through each character in the string
for char in user_word:
    # Logic: Only add the character if the clean_word is empty 
    # OR if the character is different from the very last one we added.
    if len(clean_word) == 0 or char != clean_word[-1]:
        clean_word += char

print(f"Original: {user_word}")
print(f"Modified: {clean_word}")